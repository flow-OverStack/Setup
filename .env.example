# Copy to .env (setup.sh does this automatically on first run).
# These are documented local-dev placeholders from the flow-OverStack profile README,
# safe to commit and reuse verbatim. KC_ADMIN_TOKEN is the exception: it's a real
# OAuth2 client secret, generated by setup.sh into .env, and .env is gitignored.

USERS_DB_PASSWORD=db_password
QUESTION_DB_PASSWORD=db_password
ANSWER_DB_PASSWORD=db_password
NOTIFICATION_DB_PASSWORD=db_password

PGADMIN_EMAIL=pg_email@email.com
PGADMIN_PASSWORD=pg_password

KC_BOOTSTRAP_ADMIN_USERNAME=kc_admin_username
KC_BOOTSTRAP_ADMIN_PASSWORD=kc_admin_password
KC_DB_USERNAME=kc_username
KC_DB_PASSWORD=kc_password
# KC_ADMIN_TOKEN is generated by setup.sh on first run - do not set it here.

GF_SECURITY_ADMIN_USER=gf_user
GF_SECURITY_ADMIN_PASSWORD=gf_password

REDIS_PASSWORD=redis_password
